<assembly>
    <id>${project.version}</id>
    <formats>
        <format>dir</format>
    </formats>

    <fileSets>
        <fileSet>
            <directory>src/assembly/bin</directory>
            <outputDirectory>bin</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>../tao-persistence/src/main/resources/build_scripts</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>*.ps1</include>
                <include>*.bat</include>
                <include>*.sh</include>
                <include>*.conf</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>../tao-persistence/src/main/resources/profiles/${build.profile.id}</directory>
            <outputDirectory>db</outputDirectory>
            <includes>
                <include>*.db</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>../tao-persistence/src/main/resources/persistence/scripts</directory>
            <outputDirectory>scripts</outputDirectory>
            <includes>
                <include>**/*.*</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>../tao-config/src/main/resources/profiles/${build.profile.id}</directory>
            <outputDirectory>config</outputDirectory>
            <includes>
                <include>*.properties</include>
            </includes>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>../../tao-services/tao-services-startup/src/main/resources/config/spring.properties</source>
            <outputDirectory>config</outputDirectory>
            <destName>application.properties</destName>
        </file>
    </files>
    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <outputFileNameMapping>${artifact.artifactId}-${artifact.version}.${artifact.extension}
            </outputFileNameMapping>
            <excludes>
                <exclude>ro.cs.tao:tao-*</exclude>
                <!-- Unwanted dependencies -->
                <exclude>org.checkerframework:checker-qual:jar:2.0.0</exclude>
                <exclude>commons-codec:commons-codec:jar:1.11</exclude>
                <exclude>commons-codec:commons-codec:jar:1.13</exclude>
                <exclude>org.apache.commons:commons-lang3:jar:3.8.1</exclude>
                <exclude>org.apache.commons:commons-lang3:jar:3.9</exclude>
                <exclude>org.apache.httpcomponents:httpclient:jar:4.5.1</exclude>
                <!--<exclude>com.google.guava:guava:jar:24.1.1-jre</exclude>-->
                <exclude>com.google.guava:guava:jar:25.1-jre</exclude>
                <exclude>com.google.code.findbugs:jsr305:jar:2.0.0</exclude>
                <exclude>javax:javaee-api:jar:7.0</exclude>
                <exclude>javax.activation:javax.activation-api:jar:1.2.0</exclude>
                <exclude>javax.annotation:javax.annotation-api:jar:1.3.1</exclude>
                <exclude>javax.validation:validation-api:jar:2.0.1.Final</exclude>
                <exclude>com.vividsolutions:jts-core:jar:1.14.0</exclude>
                <exclude>com.vividsolutions:jts-core:jar:1.16.1</exclude>
                <exclude>org.hibernate.validator:hibernate-validator:jar:6.0.18.Final</exclude>
                <exclude>com.sun.istack:istack-commons-runtime:jar:3.0.7</exclude>
                <exclude>com.fasterxml.jackson.core:jackson-annotations:jar:2.10.5</exclude>
                <exclude>com.fasterxml.jackson.core:jackson-core:jar:2.10.1</exclude>
                <exclude>com.fasterxml.jackson.core:jackson-core:jar:2.10.5</exclude>
                <exclude>com.fasterxml.jackson.core:jackson-databind:jar:2.10.3</exclude>
                <exclude>com.fasterxml.jackson.core:jackson-databind:jar:2.10.5</exclude>
                <exclude>com.fasterxml.jackson.module:jackson-module-jaxb-annotations:jar:2.10.5</exclude>
                <exclude>com.fasterxml.jackson.jaxrs:jackson-jaxrs-base:jar:2.10.3</exclude>
                <exclude>com.fasterxml.jackson.jaxrs:jackson-jaxrs-json-provider:jar:2.10.3</exclude>
                <exclude>com.fasterxml.jackson.module:jackson-module-jaxb-annotations:jar:2.10.5</exclude>
                <exclude>org.javassist:javassist:jar:3.24.0-GA</exclude>
                <exclude>com.sun.mail:javax.mail:jar:1.5.0</exclude>
                <exclude>javax.xml.bind:jaxb-api:jar:2.2.11</exclude>
                <exclude>org.glassfish.jaxb:jaxb-runtime:jar:2.3.1</exclude>
                <exclude>com.jcraft:jsch:jar:0.1.53</exclude>
                <exclude>com.mchange:mchange-commons-java:jar:0.2.11</exclude>
                <exclude>org.reactivestreams:reactive-streams:jar:1.0.0</exclude>
                <exclude>org.jboss.resteasy:resteasy-client:jar:3.12.0.Final</exclude>
                <exclude>org.jboss.resteasy:resteasy-jaxrs:jar:3.12.0.Final</exclude>
                <exclude>org.slf4j:slf4j-api:jar:1.7.7</exclude>
                <exclude>org.slf4j:slf4j-api:jar:1.7.21</exclude>
                <exclude>org.slf4j:slf4j-api:jar:1.7.25</exclude>
                <exclude>org.yaml:snakeyaml:jar:1.24</exclude>
                <exclude>org.springframework:spring-aop:jar:5.2.3.RELEASE</exclude>
                <exclude>org.springframework:spring-beans:jar:5.2.3.RELEASE</exclude>
                <exclude>org.springframework:spring-core:jar:5.2.3.RELEASE</exclude>
                <exclude>org.springframework:spring-expression:jar:5.2.3.RELEASE</exclude>
                <exclude>org.springframework:spring-jcl:jar:5.2.3.RELEASE</exclude>
                <exclude>org.springframework.security:spring-security-core:jar:5.2.1.RELEASE</exclude>
                <exclude>org.glassfish.jaxb:txw2:jar:2.3.1</exclude>
            </excludes>
        </dependencySet>
        <dependencySet>
            <outputDirectory>modules</outputDirectory>
            <outputFileNameMapping>${artifact.artifactId}-${artifact.version}.${artifact.extension}</outputFileNameMapping>
            <includes>
                <include>ro.cs.tao:*</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>
