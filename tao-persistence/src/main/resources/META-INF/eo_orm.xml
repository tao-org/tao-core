    </entity>

    <entity class="ro.cs.tao.execution.model.WPSExecutionTask" access="PROPERTY">

        <discriminator-value>33</discriminator-value>

        <attributes>
            <many-to-one name="component" fetch="LAZY" target-entity="ro.cs.tao.component.ogc.WPSComponent">
                <join-column name="component_id" nullable="false"/>
            </many-to-one>
            <!--<transient name="externalCommonParameters"/>-->
        </attributes>
    </entity>

    <entity class="ro.cs.tao.execution.model.WMSExecutionTask" access="PROPERTY">

        <discriminator-value>34</discriminator-value>

        <attributes>
            <many-to-one name="component" fetch="LAZY" target-entity="ro.cs.tao.component.ogc.WMSComponent">
                <join-column name="component_id" nullable="false"/>
            </many-to-one>
            <!--<transient name="externalCommonParameters"/>-->
        </attributes>
    </entity>

    <entity class="ro.cs.tao.execution.model.OGCProcessExecutionTask" access="PROPERTY">

        <discriminator-value>35</discriminator-value>

        <attributes>
            <many-to-one name="component" fetch="LAZY" target-entity="ro.cs.tao.component.ogc.OGCProcessComponent">
                <join-column name="component_id" nullable="false"/>
            </many-to-one>
            <!--<transient name="externalCommonParameters"/>-->
        </attributes>
    </entity>

    <entity class="ro.cs.tao.eodata.naming.NamingRule" access="PROPERTY">
        <table schema="product" name="naming_rule"/>
        <attributes>
            <id name="id">
                <column name="id" nullable="false" column-definition="integer NOT NULL"/>
                <generated-value strategy="IDENTITY" generator="rule_identifier"/>
            </id>
            <basic name="sensor">
                <column name="sensor" nullable="false" column-definition="varchar(50) NOT NULL"/>
            </basic>
            <basic name="regEx">
                <column name="regex" nullable="false" column-definition="varchar(512) NOT NULL"/>
            </basic>
            <basic name="description">
                <column name="description" nullable="false" column-definition="varchar(100) NOT NULL"/>
            </basic>
            <basic name="synonyms">
                <column name="synonyms" nullable="true" column-definition="varchar"/>
            </basic>
            <element-collection name="tokens" target-class="ro.cs.tao.eodata.naming.NameToken" access="PROPERTY" fetch="EAGER">
                <collection-table schema="product" name="naming_rule_token">
                    <join-column name="naming_rule_id" referenced-column-name="id"/>
                </collection-table>
            </element-collection>
        </attributes>
    </entity>

    <entity class="ro.cs.tao.workspaces.Site" access="PROPERTY">
        <table schema="workspace" name="site"/>
        <attributes>
            <basic name="name">
                <column name="name" nullable="false" column-definition="varchar(250) NOT NULL"/>
            </basic>
            <basic name="description">
                <column name="description" nullable="false" column-definition="text NOT NULL"/>
            </basic>
            <basic name="footprint">
                <column name="footprint" nullable="false" column-definition="geography(Polygon,4326) not null"/>
            </basic>
            <basic name="administrativeArea">
                <column name="administrative_area" nullable="true" column-definition="varchar"/>
                <convert converter="ro.cs.tao.persistence.convert.SiteAdministrativeAreaConverter"/>
            </basic>
            <basic name="startDate">
                <column name="start_date" nullable="false" column-definition="timestamp NOT NULL"/>
            </basic>
            <basic name="endDate">
                <column name="end_date" nullable="false" column-definition="timestamp NOT NULL"/>
            </basic>
            <basic name="userId">
                <column name="user_id" nullable="false" column-definition="varchar(50)"/>
            </basic>
        </attributes>
    </entity>

    <entity class="ro.cs.tao.gadm.Country" access="PROPERTY">
        <table schema="gadm" name="countries"/>
        <attributes>
            <id name="iso3Code">
                <column name="iso3" nullable="false" column-definition="varchar(3) NOT NULL"/>
            </id>
            <basic name="name">
                <column name="name" nullable="false" column-definition="varchar(50) NOT NULL"/>
            </basic>
            <basic name="longitude">
                <column name="lon" nullable="false" column-definition="double precision NOT NULL"/>
            </basic>
            <basic name="latitude">
                <column name="lat" nullable="false" column-definition="double precision NOT NULL"/>
            </basic>
            <basic name="extent">
                <column name="geom" nullable="false" column-definition="geometry(MultiPolygon) NOT NULL"/>
            </basic>
            <basic name="enabled">
                <column name="enabled" nullable="false" column-definition="boolean NOT NULL DEFAULT true"/>
            </basic>
            <one-to-many name="units" target-entity="ro.cs.tao.gadm.AdminL1Unit" fetch="LAZY">
                <join-column name="country_iso3" referenced-column-name="iso3"/>
            </one-to-many>
            <transient name="id"/>
        </attributes>
    </entity>

    <entity class="ro.cs.tao.gadm.AdminL1Unit" access="PROPERTY">
        <table schema="gadm" name="adm_l1"/>
        <attributes>
            <id name="id">
                <column name="id" nullable="false" column-definition="varchar(80) NOT NULL"/>
            </id>
            <basic name="name">
                <column name="name" nullable="false" column-definition="varchar(80) NOT NULL"/>
            </basic>
            <basic name="countryCode">
                <column name="country_iso3" nullable="false" column-definition="varchar(3) NOT NULL"/>
            </basic>
            <basic name="extent">
                <column name="geom" nullable="false" column-definition="geography(POLYGON, 4326) NOT NULL"/>
            </basic>
            <one-to-many name="units" target-entity="ro.cs.tao.gadm.AdminL2Unit" fetch="LAZY">
                <join-column name="l1_id" referenced-column-name="id"/>
            </one-to-many>
        </attributes>
    </entity>

    <entity class="ro.cs.tao.gadm.AdminL2Unit" access="PROPERTY">
        <table schema="gadm" name="adm_l2"/>
        <attributes>
            <id name="id">
                <column name="id" nullable="false" column-definition="varchar(80) NOT NULL"/>
            </id>
            <basic name="name">
                <column name="name" nullable="false" column-definition="varchar(80) NOT NULL"/>
            </basic>
            <basic name="adminL1Id">
                <column name="l1_id" nullable="false" column-definition="varchar(80) NOT NULL"/>
            </basic>
            <basic name="extent">
                <column name="geom" nullable="false" column-definition="geography(POLYGON, 4326) NOT NULL"/>
            </basic>
        </attributes>
    </entity>

    <embeddable class="ro.cs.tao.component.DataDescriptor" access="PROPERTY">
        <attributes>
            <basic name="formatType">
                <column name="data_format_id" nullable="false" column-definition="integer NOT NULL"/>
                <convert converter="ro.cs.tao.persistence.convert.DataFormatConverter" attribute-name="formatType" />
            </basic>
            <basic name="formatName">
                <column name="format_name" nullable="true" column-definition="varchar(30) NULL"/>
            </basic>
            <basic name="geometry">
                <column name="geometry" nullable="true" column-definition="geography(POLYGON, 4326) NULL"/>
            </basic>
            <basic name="crs">
                <column name="coordinate_reference_system" nullable="true" column-definition="text NULL"/>
            </basic>
            <basic name="sensorType">
                <column name="sensor_type_id" nullable="true" column-definition="integer NULL"/>
                <convert converter="ro.cs.tao.persistence.convert.SensorTypeConverter" attribute-name="sensorType" />
            </basic>

            <basic name="dimension">
                <column name="dimension" nullable="true" column-definition="json NULL"/>
                <convert converter="ro.cs.tao.persistence.convert.DimensionConverter" />
            </basic>

            <basic name="location">
                <column name="location" nullable="true" column-definition="varchar NULL"/>
            </basic>
        </attributes>
    </embeddable>

    <embeddable class="ro.cs.tao.eodata.naming.NameToken" access="PROPERTY">
        <attributes>
            <basic name="name">
                <column name="token_name" nullable="false" column-definition="varchar(20) NOT NULL"/>
            </basic>
            <basic name="matchingGroupNumber">
                <column name="matching_group_number" nullable="false" column-definition="integer NOT NULL"/>
            </basic>
            <basic name="description">
                <column name="description" nullable="false" column-definition="varchar(100) NOT NULL"/>
            </basic>
        </attributes>
    </embeddable>

    <converter class="ro.cs.tao.persistence.convert.PixelTypeConverter" auto-apply="false" />
    <converter class="ro.cs.tao.persistence.convert.SensorTypeConverter" auto-apply="false" />
    <converter class="ro.cs.tao.persistence.convert.DataFormatConverter" auto-apply="false" />
    <converter class="ro.cs.tao.persistence.convert.CRSConverter" auto-apply="true" />
    <converter class="ro.cs.tao.persistence.convert.DimensionConverter" auto-apply="false" />
    <converter class="ro.cs.tao.persistence.convert.SiteAdministrativeAreaConverter" auto-apply="false" />
    <converter class="ro.cs.tao.persistence.convert.SetConverter" auto-apply="false" />
    <converter class="ro.cs.tao.persistence.convert.ProductStatusConverter" auto-apply="false" />
    <converter class="ro.cs.tao.persistence.convert.WPSParameterDescriptorListConverter" auto-apply="false" />
</entity-mappings>
